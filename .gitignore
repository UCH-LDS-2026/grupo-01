# 1. Archivos subidos por los usuarios (Estudios, Recetas)
# Ignoramos todo lo que está adentro de la carpeta uploads
uploads/*
# Pero forzamos a Git a que SÍ mantenga la carpeta uploads vacía viva
!uploads/.gitkeep

# 2. Bases de datos (Evitar subir datos reales o dumps pesados)
*.sql
# Excepto el esquema estructural que sirve de manual
!schema.sql

# 3. Archivos de registro y errores (Logs)
*.log
error_log

# 4. Configuraciones locales de los editores de código
.vscode/
.idea/

# 5. Archivos basura del Sistema Operativo
.DS_Store
Thumbs.db

# Ignorar dependencias de Composer
vendor/

# Ignorar archivos subidos por los usuarios (para no subir recetas de prueba)
MediFlow/uploads/

# Ignorar reportes locales (opcional, por si no querés subir el test-report.php)
test-report.php